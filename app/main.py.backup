                        all_trades.extend(orders)
except Exception as e:
    logger.debug(f"Error loading Alpaca trades: {e}")

try:
    if os.path.exists(etrade_file):
        with open(etrade_file, 'r') as f:
            etrade_data = json.load(f)
            if isinstance(etrade_data, dict):
                for symbol, orders in etrade_data.items():
                    if isinstance(orders, list):
                        all_trades.extend(orders)
except Exception as e:
    logger.debug(f"Error loading E*TRADE trades: {e}")

# Build real portfolio from actual trades
stock_service = get_stock_service()
holdings = {}
total_cost_basis = 0

# Process trades to calculate holdings
for trade in all_trades:
    if isinstance(trade, dict):
        symbol = trade.get('symbol', '').upper()
        side = trade.get('side', '').lower()
        qty = float(trade.get('qty', 0))
        price = float(trade.get('price', 0))
        
        if symbol and price > 0:
            if symbol not in holdings:
                holdings[symbol] = {
                    'shares': 0,
                    'cost_basis_total': 0,
                    'cost_basis_per_share': 0
                }
            
            if side == 'buy':
                holdings[symbol]['shares'] += qty
                holdings[symbol]['cost_basis_total'] += qty * price
            elif side == 'sell':
                holdings[symbol]['shares'] -= qty
                holdings[symbol]['cost_basis_total'] -= qty * price
            
            if holdings[symbol]['shares'] > 0:
                holdings[symbol]['cost_basis_per_share'] = holdings[symbol]['cost_basis_total'] / holdings[symbol]['shares']

# Remove zero positions
holdings = {k: v for k, v in holdings.items() if v['shares'] > 0}

# Calculate real portfolio value
portfolio_value = 0
for symbol, holding in holdings.items():
    current_price, _, _ = stock_service.get_current_price(symbol)
    if current_price > 0:
        portfolio_value += holding['shares'] * current_price
        total_cost_basis += holding['cost_basis_total']

# Calculate real gains
total_gain = portfolio_value - total_cost_basis
total_gain_pct = (total_gain / total_cost_basis * 100) if total_cost_basis > 0 else 0

with col1:
    st.metric("Portfolio Value", f"${portfolio_value:,.2f}", f"{total_gain_pct:+.2f}%")

with col2:
    llm_result = check_llm_status()
    llm_ready = llm_result[0]
    model_count = llm_result[1]
    council_status = llm_result[2] if len(llm_result) > 2 else ""
    
    if llm_ready:
        status = f"🟢 Ready ({model_count})"
        if council_status:
            help_text = f"Council: {council_status}"
        else:
            help_text = "LLM provider available"
    else:
        status = "🔴 Not Configured"
        help_text = "Starting Council or Set GROQ_API_KEY"
    st.metric("LLM Status", status, help_text)

with col3:
    win_rate = (portfolio_value / total_cost_basis - 1) * 100 if total_cost_basis > 0 else 0
    st.metric("Total Gain", f"${total_gain:+,.2f}", f"{win_rate:+.1f}%")

