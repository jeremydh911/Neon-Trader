def check_llm_status():
    """Check status of council LLM services + RAG memory system"""
    import os
    from pathlib import Path
    from dotenv import load_dotenv
    
    # Load .env file explicitly
    env_file = Path(__file__).parent.parent / '.env'
    if env_file.exists():
        load_dotenv(env_file)
    else:
        load_dotenv()
    
    # Check for available LLM providers
    providers = {}
    council_members = {}
    
    # Check for local Ollama services - these are the council members
    council_ports = {
        'Technical': 11434,
        'Sentiment': 11435,
        'Reason': 11436
    }
    
    for member_name, port in council_ports.items():
        try:
            # Try docker network name first
            response = requests.get(f"http://council-ollama-{member_name.lower()}:11434/api/tags", timeout=2)
            if response.status_code == 200:
                models = response.json().get('models', [])
                council_members[member_name] = len(models)
                providers['ollama'] = True
                logger.info(f"✅ Council {member_name}: Online ({len(models)} models)")
        except:
            try:
                # Fallback to localhost
                response = requests.get(f"http://127.0.0.1:{port}/api/tags", timeout=2)
                if response.status_code == 200:
                    models = response.json().get('models', [])
                    council_members[member_name] = len(models)
                    providers['ollama'] = True
                    logger.info(f"✅ Council {member_name}: Online ({len(models)} models)")
            except Exception as e:
                logger.debug(f"Council {member_name} unavailable: {e}")
                council_members[member_name] = 0
    
    # Check RAG Memory Service
    try:
        response = requests.get(f"http://rag-memory-service:9091/healthz", timeout=2)
        if response.status_code == 200:
            providers['rag'] = True
            logger.info(f"✅ RAG Memory Service: Online")
    except:
        try:
            response = requests.get(f"http://rag-memory-service:6333/health", timeout=2)
            if response.status_code == 200:
                providers['rag'] = True
                logger.info(f"✅ RAG Memory Service: Online (localhost)")
        except Exception as e:
            logger.debug(f"RAG service unavailable: {e}")
    
    # Check Groq API (backup)
    groq_key = os.getenv('GROQ_API_KEY', '').strip()
    if groq_key:
        providers['groq'] = True
        logger.info(f"✅ Groq API key detected")
    
    # Check OpenAI API (backup)
    openai_key = os.getenv('OPENAI_API_KEY', '').strip()
    if openai_key:
        providers['openai'] = True
        logger.info(f"✅ OpenAI API key detected")
    
    is_ready = len(providers) > 0
    model_count = len(providers)
    council_status = " | ".join([f"{k}:{v}" for k, v in council_members.items()])
    
    
    if not is_ready:
        logger.warning("⚠️ No LLM providers configured. Set GROQ_API_KEY, OPENAI_API_KEY, or start Ollama Council")
    
    return is_ready, model_count, council_status

