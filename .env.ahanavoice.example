# AhanaVoice — borrow engine + 16KB-class seats for Tim
#
# Voices: vendor/ahanavoice/jeremiah-av-experts-cpu.aarm (~50,950 B)
# Roster: vendor/ahanavoice/individuals.json
# Default seat: drew-three-am
# Sync:     python scripts/sync_ahanavoice.py

# Engine mode: borrow (default) | local | preview
#   borrow  = AhanaVoice cloud /api/say first (mouth borrowed, pack is ours)
#   local   = AHANAVOICE_URL / serve_aarm first
#   preview = desk-preview only
AHANAVOICE_ENGINE=borrow

# Optional local serve_aarm / desk mouth
# AHANAVOICE_URL=http://127.0.0.1:9635

AHANAVOICE_VOICE=drew-three-am

AHANAVOICE_ALLOW_CLOUD=1
# AHANAVOICE_CLOUD_URL=https://ahanavoice.com

AHANAVOICE_ALLOW_PREVIEW=1

# Optional pack override
# AHANAVOICE_PACK=./vendor/ahanavoice/jeremiah-av-experts-cpu.aarm
# AHANAVOICE_ROSTER=./vendor/ahanavoice/individuals.json

# Local desk serve (proxies borrow engine when AHANAVOICE_ENGINE=borrow)
# python scripts/serve_ahanavoice.py --port 9635
# AHANAVOICE_SERVE_HOST=127.0.0.1
# AHANAVOICE_SERVE_PORT=9635
