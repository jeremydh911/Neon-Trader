# --- Secrets / credentials (never commit) ---
# E*TRADE
etrade.env
**/etrade.env
.secrets/
**/.secrets/
*.etrade.env
app/config/etrade-credentials.json
config/etrade-credentials.json
**/etrade-credentials.json
config/.etrade_tokens
**/.etrade_tokens
.etrade_tokens

# Other providers (keep only *.example* templates in git)
config/*credentials*.json
!config/*.example.json
!config/*.json.example

# Common secret artifacts (local-only)
.production_secrets.txt
production_secrets.txt
.secrets_generated
data/.encryption_key
data/tokens/
data/tokens/**

# --- Runtime data / artifacts ---
data/*.db
data/*.db-journal
data/*.sqlite*
data/*.sqlite3*
app/data/
app/data/**

# --- Local env files ---
.env
.env.*
!.env*.example

# --- Tooling / editor ---
.vscode/
.blackbox/
.blackboxrules

# --- Python cache ---
__pycache__/
*.pyc

# --- Backups ---
*.bak
*.backup

# Streamlit local cache
app/.streamlit/

# Portainer
.portainer_token

# OAuth JSON token store (never commit)
etrade_oauth_request.json
etrade_oauth_tokens.json
**/etrade_oauth_request.json
**/etrade_oauth_tokens.json
