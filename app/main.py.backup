# Auto-refresh configuration (45 seconds for faster trading)
REFRESH_INTERVAL = 45  # seconds - reduced from 120 for day trading responsiveness

def setup_auto_refresh():
    """Setup automatic page refresh every 45 seconds for responsive day trading"""
    if 'last_refresh' not in st.session_state:
        st.session_state.last_refresh = time.time()
    
    current_time = time.time()
    time_since_refresh = current_time - st.session_state.last_refresh
    
    if time_since_refresh >= REFRESH_INTERVAL:
        st.session_state.last_refresh = current_time
        st.rerun()
    
    # Display refresh status
    time_until_refresh = REFRESH_INTERVAL - time_since_refresh
    st.sidebar.metric("⏱️ Auto-Refresh In", f"{int(time_until_refresh)}s", "45s interval")

def is_trading_hours():
    """Check if current time is within trading hours (1:00 AM Hawaii time onwards)"""
    hawaii_tz = timezone('Pacific/Honolulu')
    hawaii_time = datetime.now(hawaii_tz)
    
    # Trading hours: 1:00 AM Hawaii time onwards (market opens at 1:00 AM Hawaii = 10:30 AM ET)
    trading_start_hour = 1
    trading_end_hour = 24  # Runs all day once started
    
    is_active = hawaii_time.hour >= trading_start_hour
    
    return is_active, hawaii_time

def load_page_module(page_name, file_path):
    """Dynamically load a page module"""
    spec = importlib.util.spec_from_file_location(page_name, file_path)
    module = importlib.util.module_from_spec(spec)
    sys.modules[page_name] = module
    spec.loader.exec_module(module)
    return module


