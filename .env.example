# E*TRADE — copy to etrade.env (gitignored) or export in the shell.
# Never commit real keys.

ETRADE_CONSUMER_KEY=
ETRADE_CONSUMER_SECRET=
ETRADE_ENV=sandbox
# ETRADE_ACCESS_TOKEN=
# ETRADE_ACCESS_TOKEN_SECRET=
# ETRADE_ENV_FILE=/home/box/.secrets/etrade.env
# ETRADE_OAUTH_STATE_FILE=/home/box/.secrets/etrade_oauth_request.json
# ETRADE_ACCESS_TOKEN_FILE=/home/box/.secrets/etrade_oauth_tokens.json

# Live requires ETRADE_ENV=production AND confirm_live=True on each place.
# Desk is LIMIT-only. Session 07:00–20:00 ET (HT = ET-6 in August).
# Blackout 04:00–07:00 ET. Cancel-before-roll 09:28 ET. Overnight out after 20:00 ET.

# Plug-in agent brain (optional). If unset, Tina/Eddie/Gloria/Victor/Riley council is used.
# AHANA_BRAIN_URL=
# AHANA_BRAIN_TOKEN=
# AHANA_BRAIN_MODEL=grok

# Private-stack adapters (optional; no-op if the package is not installed)
# AHANAFLOW_URL=
# CHATWIRE_URL=
# AHANAZIP_DIR=

# AhanaFlow lookback (AhanaAi-Company/AhanaFlow SDK — import-or-stub, never vendored)
# AHANAFLOW_URL=
# AHANAFLOW_LICENSE=
# AHANAFLOW_TOKEN=
# AHANAFLOW_DATA_DIR=./data/ahanaflow
# AHANAZIP_DIR=
# CHATWIRE_URL=

# Kona Latch experimental detector (default off)
# AHANA_KONA_LATCH=0
