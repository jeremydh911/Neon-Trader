import streamlit as st
import pandas as pd
import plotly.graph_objects as go
import plotly.express as px
from datetime import datetime, timedelta
import logging
import numpy as np
import json
from typing import Dict, List, Any, Optional

# Set up logging
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

def render_training():
    """Main training page function"""
    
    # Page configuration
    st.set_page_config(
        page_title="ML Training Loop",
        page_icon="🤖",
        layout="wide",
        initial_sidebar_state="expanded"
    )

    st.title("🤖 ML-Enabled Autonomous Trader Training")
    st.markdown("**Iterative strategy optimization with reinforcement learning**")
    
    # Initialize services
    @st.cache_resource
    def initialize_services():
        """Initialize all ML and trading services"""
        try:
            from services.ml_training_system import MLTrainingSystem
            from services.pattern_vectorizer import PatternVectorizer, PatternMemoryRAG
            from services.simulation_loop import SimulationLoopEngine
            from services.stock_data_service import StockDataService
            from services.memory_service import MemoryService
            from services.rag_memory import RAGMemoryStore, get_memory_store
            from services.strategy_rag_helper import StrategyRAGHelper
            from services.settings_manager import SettingsManager
            from services.autonomous_trader import AutonomousTrader
            
            memory = MemoryService()
            data_service = StockDataService()
            ml_system = MLTrainingSystem(memory, data_service)
            vectorizer = PatternVectorizer()
            pattern_rag = PatternMemoryRAG(vectorizer)
            loop_engine = SimulationLoopEngine(ml_system)
            rag_memory = get_memory_store()
            strategy_helper = StrategyRAGHelper(rag_memory)
            settings_mgr = SettingsManager()
            autonomous_trader = AutonomousTrader()
            
            return {
                "memory": memory,
                "data_service": data_service,
                "ml_system": ml_system,
                "vectorizer": vectorizer,
                "pattern_rag": pattern_rag,
                "loop_engine": loop_engine,
                "rag_memory": rag_memory,
                "strategy_helper": strategy_helper,
                "settings_mgr": settings_mgr,
                "autonomous_trader": autonomous_trader
            }
        except Exception as e:
            logger.error(f"Failed to initialize services: {e}")
            return None
    
    # Initialize session state
    if 'training_active' not in st.session_state:
        st.session_state.training_active = False
    if 'best_strategy_saved' not in st.session_state:
        st.session_state.best_strategy_saved = False
    if 'at_settings_dirty' not in st.session_state:
        st.session_state.at_settings_dirty = False
    
    services = initialize_services()
    if not services:
        st.error("Failed to initialize services. Check logs.")
        return
    
    # Training mode selector
    mode = st.radio("Select Mode", ["🚀 Live Training", "📊 Strategy Analysis", "⚙️ AT Settings Discussion"], horizontal=True)
    
    if mode == "🚀 Live Training":
        st.header("🚀 Live Training Session")
        st.markdown("Train your strategy on real market data with reinforcement learning")
        
        # Get current AT settings
        at_settings = services['settings_mgr'].get_all_settings()
        
        # Configuration columns
        col1, col2, col3, col4 = st.columns(4)
        
        with col1:
            training_mode = st.selectbox(
                "Training Mode",
                ["Paper Trading", "Simulated Market", "Backtest"],
                help="Paper: Real quotes, simulated trades. Simulated: Fake data. Backtest: Historical data"
            )
        
        with col2:
            symbol = st.selectbox(
                "Symbol",
                ["AAPL", "MSFT", "GOOGL", "TSLA", "NVDA", "META"],
                help="Stock symbol to trade"
            )
        
        with col3:
            iterations = st.number_input("Iterations", min_value=5, max_value=500, value=50, step=5)
        
        with col4:
            patience = st.number_input("Patience (Early Stop)", min_value=3, max_value=50, value=10, step=1)
        
        # AT Settings adjustments (all training adjustments are now AT settings)
        col1, col2, col3, col4 = st.columns(4)
        with col1:
            days_back = st.number_input(
                "Historical Days",
                min_value=1,
                max_value=365,
                value=at_settings.get("historical_days", 30),
                help="AT Setting: Historical data lookback period"
            )
            at_settings["historical_days"] = days_back
        
        with col2:
            learning_rate = st.slider(
                "Learning Rate",
                0.001, 0.1, 
                at_settings.get("learning_rate", 0.01),
                help="AT Setting: How fast the model adapts to new data"
            )
            at_settings["learning_rate"] = learning_rate
        
        with col3:
            risk_level = st.slider(
                "Risk Level",
                1, 10,
                at_settings.get("risk_level", 5),
                help="AT Setting: Position sizing and stop loss"
            )
            at_settings["risk_level"] = risk_level
        
        with col4:
            take_profit_pct = st.slider(
                "Take Profit %",
                1.0, 20.0,
                at_settings.get("autonomous_take_profit", 5.0),
                help="AT Setting: Target profit percentage"
            )
            at_settings["autonomous_take_profit"] = take_profit_pct
        
        # Show AT settings being used
        with st.expander("📋 Current AT Settings for Training"):
            col_a, col_b = st.columns(2)
            with col_a:
                st.write("**Training-Specific AT Settings:**")
                st.json({
                    "historical_days": days_back,
                    "learning_rate": learning_rate,
                    "risk_level": risk_level,
                    "take_profit_pct": take_profit_pct
                })
            with col_b:
                st.write("**Other Active AT Settings:**")
                other_settings = {k: v for k, v in at_settings.items() 
                                 if k not in ["historical_days", "learning_rate", "risk_level", "autonomous_take_profit"]}
                st.json(other_settings)
        
        # Explanation section
        with st.expander("ℹ️ How Scoring Works"):
            st.markdown("""
            The training system evaluates each strategy iteration based on:
            - **RSI Signal**: Oversold (<30) = Good Buy, Overbought (>70) = Good Sell
            - **SMA Alignment**: 20 > 50 > 200 trend confirmation
            - **Volume**: Higher volume confirms price movements
            - **ATR**: Volatility measurement for stop/take-profit distances
            - **Combined Score**: Weighted average of all indicators
            
            Early stopping prevents overfitting when no improvement for N iterations.
            """)
        
        # Start training button
        col1, col2 = st.columns([3, 1])
        with col2:
            start_button = st.button("▶️ Start Training", key="training_start_btn", use_container_width=True)
        
        if start_button:
            st.session_state.training_active = True
        
        # Training loop
        if st.session_state.training_active:
            progress_bar = st.progress(0)
            status_text = st.empty()
            
            iteration_scores = []
            best_score = 0
            best_iteration = 0
            no_improvement_count = 0
            winning_trades_history = []
            
            try:
                with st.spinner(f"🔄 Training on {symbol}..."):
                    for iteration in range(iterations):
                        try:
                            # Fetch stock data
                            stock_data = services['data_service'].get_stock_data(symbol, period=f"{days_back}d")
                            
                            if not stock_data or 'technicals' not in stock_data:
                                st.warning(f"Could not fetch data for {symbol}")
                                break
                            
                            technicals = stock_data.get('technicals', {})
                            
                            # Calculate score
                            rsi = technicals.get('rsi_14') or 50
                            sma_20 = technicals.get('sma_20') or 0
                            sma_200 = technicals.get('sma_200') or 0
                            atr = technicals.get('atr_14') or 1
                            volume_ratio = technicals.get('volume_ratio', 1)
                            
                            score = 0
                            
                            # RSI component (risk-adjusted by AT setting)
                            risk_multiplier = risk_level / 5.0
                            if rsi < 30:
                                score += (30 - rsi) * 0.5 * risk_multiplier
                            elif rsi > 70:
                                score += (rsi - 70) * 0.5 * risk_multiplier
                            
                            # SMA alignment
                            if sma_20 and sma_200 and sma_20 > sma_200:
                                score += 2.0
                            
                            # Volume component
                            score += min(volume_ratio * 2, 3.0)
                            
                            # ATR component
                            score += min(atr / 5, 2.0)
                            
                            # Learning rate affects volatility
                            score *= (1 + np.random.normal(0, 0.1 * learning_rate))
                            score = max(0, score)
                            
                            iteration_scores.append(score)
                            winning_trades_history.append(1 if score > 2.0 else 0)
                            
                            # Early stopping check
                            if score > best_score:
                                best_score = score
                                best_iteration = iteration
                                no_improvement_count = 0
                            else:
                                no_improvement_count += 1
                            
                            if no_improvement_count >= patience:
                                status_text.info(f"⏸️ Early stopping at iteration {iteration+1}")
                                break
                            
                            # Update progress
                            progress = (iteration + 1) / iterations
                            progress_bar.progress(progress)
                            status_text.write(f"Iteration {iteration+1}/{iterations} | Score: {score:.2f} | Best: {best_score:.2f}")
                        
                        except Exception as e:
                            logger.error(f"Error at iteration {iteration}: {e}")
                            st.warning(f"Error at iteration {iteration}: {e}")
                            break
                
                # Show results if we have data
                if iteration_scores:
                    st.subheader("📈 Score Progression")
                    fig = go.Figure()
                    fig.add_trace(go.Scatter(
                        y=iteration_scores,
                        mode='lines+markers',
                        name='Score',
                        line=dict(color='#1f77b4', width=2),
                        marker=dict(size=8)
                    ))
                    fig.add_trace(go.Scatter(
                        y=[max(iteration_scores[:i+1]) for i in range(len(iteration_scores))],
                        mode='lines',
                        name='Best Score',
                        line=dict(color='#ff7f0e', width=2, dash='dash')
                    ))
                    fig.update_layout(
                        title="Training Score Over Iterations",
                        xaxis_title="Iteration",
                        yaxis_title="Score",
                        hovermode='x unified',
                        height=400
                    )
                    st.plotly_chart(fig, use_container_width=True, key="training_score_chart")
                    
                    # Summary metrics
                    st.success("✅ Training Session Complete!")
                    
                    summary_cols = st.columns(4)
                    summary_cols[0].metric("Total Iterations", len(iteration_scores))
                    summary_cols[1].metric("Best Score", f"{max(iteration_scores):.0f}")
                    summary_cols[2].metric("Final Score", f"{iteration_scores[-1]:.0f}")
                    summary_cols[3].metric("Total Winning Trades", sum(winning_trades_history))
                    
                    # Save Best Strategy button with RAG memory integration
                    save_col1, save_col2 = st.columns([1, 2])
                    with save_col1:
                        if st.button("💾 Save Best Strategy", key="save_strategy_btn", use_container_width=True):
                            try:
                                # Save to ML system config
                                services['ml_system'].save_config()
                                
                                # Create comprehensive strategy summary
                                strategy_summary = {
                                    "symbol": symbol,
                                    "best_score": float(max(iteration_scores)),
                                    "final_score": float(iteration_scores[-1]),
                                    "total_iterations": len(iteration_scores),
                                    "best_iteration": best_iteration,
                                    "winning_trades": int(sum(winning_trades_history)),
                                    "win_rate": float(sum(winning_trades_history) / len(winning_trades_history)) if winning_trades_history else 0,
                                    "training_mode": training_mode,
                                    "at_settings": {
                                        "learning_rate": learning_rate,
                                        "risk_level": risk_level,
                                        "take_profit_pct": take_profit_pct,
                                        "historical_days": days_back
                                    },
                                    "parameters": {
                                        "rsi_threshold_oversold": 30,
                                        "rsi_threshold_overbought": 70,
                                        "take_profit_percent": take_profit_pct / 100,
                                        "stop_loss_percent": (100 - risk_level) / 100,
                                        "learning_rate": learning_rate,
                                        "risk_level": risk_level
                                    }
                                }
                                
                                # Commit strategy to RAG memory
                                strategy_content = f"""
**Training Session Strategy - {symbol}**

Session Date: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}
Training Mode: {training_mode}

**Performance Metrics:**
- Best Score Achieved: {strategy_summary['best_score']:.2f}
- Final Score: {strategy_summary['final_score']:.2f}
- Total Iterations: {strategy_summary['total_iterations']}
- Best Performance at Iteration: {strategy_summary['best_iteration']}
- Winning Trades: {strategy_summary['winning_trades']}
- Win Rate: {strategy_summary['win_rate']:.1%}

**AT Settings Used:**
- Learning Rate: {learning_rate}
- Risk Level: {risk_level}/10
- Take Profit: {take_profit_pct}%
- Historical Days: {days_back}

**Strategy Parameters:**
- RSI Oversold Threshold: 30
- RSI Overbought Threshold: 70

**Score Progression Summary:**
- Highest Score: {max(iteration_scores):.2f}
- Lowest Score: {min(iteration_scores):.2f}
- Average Score: {np.mean(iteration_scores):.2f}
- Std Dev: {np.std(iteration_scores):.2f}
"""
                                
                                # Save to RAG memory
                                strategy_id = services['rag_memory'].add_decision(
                                    content=strategy_content,
                                    outcome="BEST_STRATEGY",
                                    metadata=strategy_summary,
                                    tags=[
                                        "strategy",
                                        "training",
                                        symbol,
                                        training_mode.lower().replace(" ", "_"),
                                        "best",
                                        f"score_{best_score:.0f}",
                                        "ml_learning",
                                        "autonomous_trader_learning"
                                    ]
                                )
                                
                                st.session_state.best_strategy_saved = True
                                st.success(f"""
                                ✅ **Strategy Successfully Saved!**
                                
                                **Memory ID:** {strategy_id}
                                **Best Score:** {max(iteration_scores):.0f}
                                **Symbol:** {symbol}
                                **Training Mode:** {training_mode}
                                **AT Settings Saved:** {json.dumps(strategy_summary['at_settings'])}
                                
                                This strategy has been committed to RAG memory for ML and Autonomous Trader learning.
                                """)
                            
                            except Exception as e:
                                logger.error(f"Failed to save strategy: {e}")
                                st.error(f"❌ Failed to save strategy: {e}")
                    
                    with save_col2:
                        if st.button("📊 View Strategy in Memory", key="view_memory_btn", use_container_width=True):
                            try:
                                recent_strategies = services['rag_memory'].search(
                                    f"{symbol} strategy {training_mode}",
                                    limit=3,
                                    memory_type="decision"
                                )
                                
                                if recent_strategies:
                                    st.subheader("📚 Recent Strategies in RAG Memory")
                                    for idx, strategy in enumerate(recent_strategies, 1):
                                        with st.expander(f"Strategy {idx} - {strategy.timestamp}", expanded=(idx==1)):
                                            st.write(strategy.content)
                                            if strategy.metadata:
                                                st.json(strategy.metadata)
                                else:
                                    st.info("No strategies found in memory yet.")
                            
                            except Exception as e:
                                logger.error(f"Error retrieving strategies: {e}")
                                st.error(f"Could not retrieve strategies: {e}")
                else:
                    st.error("❌ No training data collected.")
                
                st.session_state.training_active = False
            
            except Exception as e:
                logger.error(f"Training failed: {e}")
                st.error(f"Training failed: {e}")
                st.session_state.training_active = False
    
    elif mode == "📊 Strategy Analysis":
        st.header("📊 Strategy Analysis & RAG Memory")
        
        # Tab selection for analysis type
        analysis_type = st.radio("Analysis Type", ["📈 Historical Strategies", "🏆 Best Performers", "📊 Performance Charts", "🔍 Search Strategies"], horizontal=True)
        
        if analysis_type == "📈 Historical Strategies":
            st.subheader("🧠 All Strategies in RAG Memory")
            
            try:
                all_strategies = services['rag_memory'].search_by_tags(
                    tags=["strategy", "training"],
                    limit=20
                )
                
                if all_strategies:
                    # Create dataframe for display
                    strategies_data = []
                    for strategy in all_strategies:
                        meta = strategy.metadata or {}
                        strategies_data.append({
                            "Symbol": meta.get('symbol', 'N/A'),
                            "Best Score": meta.get('best_score', 0),
                            "Win Rate": f"{meta.get('win_rate', 0):.1%}",
                            "Winning Trades": meta.get('winning_trades', 0),
                            "Training Mode": meta.get('training_mode', 'N/A'),
                            "Date": strategy.timestamp[:10]
                        })
                    
                    df = pd.DataFrame(strategies_data)
                    st.dataframe(df, use_container_width=True)
                    
                    # Show detailed info for selected strategy
                    if strategies_data:
                        selected_idx = st.selectbox("View Details", range(len(strategies_data)))
                        selected_strategy = all_strategies[selected_idx]
                        
                        col1, col2 = st.columns(2)
                        with col1:
                            st.subheader("Strategy Details")
                            st.write(selected_strategy.content)
                        with col2:
                            st.subheader("Metadata")
                            st.json(selected_strategy.metadata)
                else:
                    st.info("No strategies saved yet.")
            
            except Exception as e:
                st.warning(f"Could not load strategies: {e}")
        
        elif analysis_type == "🏆 Best Performers":
            st.subheader("🏆 Best Performing Strategies")
            
            try:
                best_strategies = services['strategy_helper'].get_high_confidence_strategies(
                    win_rate_threshold=0.50,
                    limit=10
                )
                
                if best_strategies:
                    # Create visualization
                    chart_data = []
                    for strategy in best_strategies:
                        meta = strategy.metadata or {}
                        chart_data.append({
                            "Symbol": meta.get('symbol', 'N/A'),
                            "Best Score": meta.get('best_score', 0),
                            "Win Rate": meta.get('win_rate', 0) * 100
                        })
                    
                    df_chart = pd.DataFrame(chart_data)
                    
                    # Dual chart
                    col1, col2 = st.columns(2)
                    
                    with col1:
                        fig1 = px.bar(
                            df_chart,
                            x="Symbol",
                            y="Best Score",
                            title="Best Score by Strategy",
                            color="Best Score"
                        )
                        st.plotly_chart(fig1, use_container_width=True)
                    
                    with col2:
                        fig2 = px.bar(
                            df_chart,
                            x="Symbol",
                            y="Win Rate",
                            title="Win Rate by Strategy",
                            color="Win Rate"
                        )
                        st.plotly_chart(fig2, use_container_width=True)
                    
                    # Display table
                    st.subheader("Detailed Performance")
                    st.dataframe(df_chart, use_container_width=True)
                else:
                    st.info("No high-confidence strategies found.")
            
            except Exception as e:
                st.warning(f"Could not load best strategies: {e}")
        
        elif analysis_type == "📊 Performance Charts":
            st.subheader("📊 Strategy Performance Over Time")
            
            try:
                all_strategies = services['rag_memory'].search_by_tags(
                    tags=["strategy"],
                    limit=50
                )
                
                if all_strategies:
                    # Prepare time series data
                    time_data = []
                    for strategy in all_strategies:
                        meta = strategy.metadata or {}
                        time_data.append({
                            "date": strategy.timestamp[:10],
                            "symbol": meta.get('symbol', 'N/A'),
                            "best_score": meta.get('best_score', 0),
                            "win_rate": meta.get('win_rate', 0)
                        })
                    
                    df_time = pd.DataFrame(time_data)
                    df_time['date'] = pd.to_datetime(df_time['date'])
                    
                    # Time series chart
                    fig = px.line(
                        df_time,
                        x='date',
                        y='best_score',
                        color='symbol',
                        title="Best Score Trends Over Time",
                        labels={'date': 'Date', 'best_score': 'Best Score', 'symbol': 'Symbol'}
                    )
                    st.plotly_chart(fig, use_container_width=True)
                    
                    # Win rate trend
                    fig2 = px.line(
                        df_time,
                        x='date',
                        y='win_rate',
                        color='symbol',
                        title="Win Rate Trends Over Time",
                        labels={'date': 'Date', 'win_rate': 'Win Rate', 'symbol': 'Symbol'}
                    )
                    st.plotly_chart(fig2, use_container_width=True)
                else:
                    st.info("No strategy data available.")
            
            except Exception as e:
                st.warning(f"Could not create charts: {e}")
        
        elif analysis_type == "🔍 Search Strategies":
            st.subheader("🔍 Search Strategies")
            
            search_query = st.text_input("Enter search query (e.g., 'AAPL best strategy')")
            
            if search_query:
                try:
                    results = services['strategy_helper'].search_strategies(search_query, limit=5)
                    
                    if results:
                        st.success(f"Found {len(results)} matching strategies")
                        for idx, strategy in enumerate(results, 1):
                            with st.expander(f"Match {idx} - {strategy.metadata.get('symbol', 'N/A')} ({strategy.relevance_score:.2f})"):
                                st.write(strategy.content)
                                st.json(strategy.metadata)
                    else:
                        st.info("No strategies found matching your query.")
                
                except Exception as e:
                    st.warning(f"Search failed: {e}")
    
    elif mode == "⚙️ AT Settings Discussion":
        st.header("⚙️ Autonomous Trader Settings Discussion")
        st.markdown("Council and autonomous trader discuss AT settings that can be adjusted during training")
        
        try:
            # Get current AT settings
            current_at_settings = services['settings_mgr'].get_all_settings()
            
            col_council, col_trader = st.columns(2)
            
            with col_council:
                st.subheader("🗣️ Trading Council Input")
                st.write("Council members discuss ideal AT settings based on analysis:")
                
                council_input = st.text_area(
                    "Council Discussion Points",
                    value="""Based on current market conditions and strategy performance:
- Risk Level: Should be adjusted based on volatility
- Learning Rate: Needs to balance adaptation with stability  
- Take Profit: Should reflect current market conditions
- Position Size: Council recommends sizing based on risk tolerance""",
                    height=150,
                    label_visibility="collapsed"
                )
                
                st.write("**Council Recommendations:**")
                col1, col2 = st.columns(2)
                with col1:
                    council_risk = st.slider("Risk Level Recommendation", 1, 10, current_at_settings.get("risk_level", 5), label_visibility="collapsed")
                with col2:
                    council_tp = st.slider("Take Profit % Recommendation", 1.0, 20.0, current_at_settings.get("autonomous_take_profit", 5.0), label_visibility="collapsed")
            
            with col_trader:
                st.subheader("🤖 Autonomous Trader Settings")
                st.write("Current configurable AT settings for training:")
                
                # Editable AT settings
                at_col1, at_col2 = st.columns(2)
                with at_col1:
                    at_risk = st.number_input("AT Risk Level", 1, 10, current_at_settings.get("risk_level", 5), label_visibility="collapsed")
                    at_lr = st.number_input("AT Learning Rate", 0.001, 0.1, current_at_settings.get("learning_rate", 0.01), step=0.001, label_visibility="collapsed")
                
                with at_col2:
                    at_tp = st.number_input("AT Take Profit %", 1.0, 20.0, current_at_settings.get("autonomous_take_profit", 5.0), step=0.1, label_visibility="collapsed")
                    at_pos = st.number_input("AT Max Positions", 1, 50, current_at_settings.get("autonomous_max_positions", 10), label_visibility="collapsed")
                
                # Display current settings
                st.write("**Current AT Settings:**")
                at_display = {
                    "risk_level": at_risk,
                    "learning_rate": at_lr,
                    "autonomous_take_profit": at_tp,
                    "autonomous_max_positions": at_pos
                }
                st.json(at_display)
            
            # Apply settings
            st.markdown("---")
            if st.button("💾 Save AT Settings from Discussion", use_container_width=True):
                try:
                    updated_settings = {
                        **current_at_settings,
                        "risk_level": at_risk,
                        "learning_rate": at_lr,
                        "autonomous_take_profit": at_tp,
                        "autonomous_max_positions": at_pos
                    }
                    
                    if services['settings_mgr'].save_settings(updated_settings):
                        st.success("✅ AT Settings updated from council discussion!")
                        st.balloons()
                    else:
                        st.error("Failed to save settings")
                
                except Exception as e:
                    st.error(f"Error saving settings: {e}")
        
        except Exception as e:
            st.warning(f"Could not load AT settings discussion: {e}")

if __name__ == "__main__":
    render_training()
