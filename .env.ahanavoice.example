# AhanaVoice — Jeremiah's tiny mastered pack for Tim narration
#
# Pack: vendor/ahanavoice/jeremiah-av-experts-cpu.aarm (~50,950 B, 100 seats)
# Roster: vendor/ahanavoice/individuals.json
# Default Tim seat: drew-three-am

# Optional: real serve_aarm / desk mouth (OpenAI-style /v1/audio/speech)
# AHANAVOICE_URL=http://127.0.0.1:9635

# Seat / alias (tim|jeremiah → drew-three-am)
AHANAVOICE_VOICE=drew-three-am

# Borrow cloud mouth from ahanavoice.com when local serve is quiet
AHANAVOICE_ALLOW_CLOUD=1
# AHANAVOICE_CLOUD_URL=https://ahanavoice.com

# Honest local desk-preview when cloud/serve_aarm unavailable
AHANAVOICE_ALLOW_PREVIEW=1

# Optional pack override
# AHANAVOICE_PACK=./vendor/ahanavoice/jeremiah-av-experts-cpu.aarm
# AHANAVOICE_ROSTER=./vendor/ahanavoice/individuals.json

# Local desk serve: python scripts/serve_ahanavoice.py --port 9635
# AHANAVOICE_SERVE_HOST=127.0.0.1
# AHANAVOICE_SERVE_PORT=9635
