{
  "finnhub": {
    "api_key": "YOUR_FINNHUB_API_KEY",
    "webhook_secret": "YOUR_FINNHUB_WEBHOOK_SECRET",
    "base_url": "https://finnhub.io/api/v1",
    "enabled": true,
    "purpose": "Backup market data source when primary broker data is unavailable",
    "features": {
      "real_time_quotes": true,
      "company_news": true,
      "earnings_calendar": true,
      "market_status": true,
      "historical_data": true
    },
    "rate_limits": {
      "free_tier_calls_per_minute": 60,
      "free_tier_calls_per_month": 2000
    },
    "webhook": {
      "enabled": false,
      "secret_header": "X-Finnhub-Secret",
      "secret_value": "YOUR_FINNHUB_WEBHOOK_SECRET",
      "acknowledge_timeout_seconds": 5,
      "http_status_required": "2xx",
      "endpoint": "http://localhost:8501/api/webhooks/finnhub"
    },
    "fallback_priority": 2,
    "notes": "Primary source: brokerage OAuth. Secondary: Finnhub API"
  }
}
