# AhanaFlow — Neon Trader production env (self-hosted preferred)
# Copy to .env or export before starting Tim / Streamlit.

# Master switch (1 = AhanaFlow, 0 = legacy JSON RAG)
AHANAFLOW_MEMORY=1

# auto | selfhosted | embedded | remote
# auto tries selfhosted then falls back to embedded
AHANAFLOW_MODE=selfhosted

# Local vector server (run: ./scripts/run_ahanaflow_selfhost.sh)
AHANAFLOW_HOST=127.0.0.1
AHANAFLOW_PORT=9634
AHANAFLOW_WAL=./data/ahanaflow/tim_memory.wal

# Collection + embedding dim (must match across restarts)
AHANAFLOW_COLLECTION=tim_memory
AHANAFLOW_EMBED_DIM=128

# Client resilience
AHANAFLOW_TIMEOUT=5.0
AHANAFLOW_RETRIES=3

# Optional auth (recommended if not strictly localhost-only)
# AHANAFLOW_REQUIRE_AUTH=1
# AHANAFLOW_API_KEY=replace-with-long-random-secret
# AHANAFLOW_API_KEYS_FILE=./data/ahanaflow/api_key_hashes.txt

# Only set if you intentionally bind 0.0.0.0
# AHANAFLOW_ALLOW_PUBLIC=0

PAPER_MODE=1
USE_MOCK_BROKER=1
PYTHONPATH=.
